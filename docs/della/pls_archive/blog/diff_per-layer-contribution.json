    "def loss_fn(model, tokens):",
    "    targets = tokens[1:]",
    "    x = model.embed(tokens[:-1])",
    "    loss = 0.0",
    "    for k, block in enumerate(model.blocks[:-1]):",
    "        x = block(x)",
    "        # 探针：读取这一层，但梯度不传回模型",
    "        h = stop_gradient(x) if probe else x",
    "        # 前面每一层都有自己的 norm 和输出头，也预测下一个词",
    "        logits = model.layer_heads[k](model.layer_norms[k](h))",
    "        loss += cross_entropy(logits, targets)",
    "    x = model.blocks[-1](x)",
    "    # 最后一层仍是原来的损失，权重相同",
