   "base": [
    "def loss_fn(model, tokens):",
    "    targets = tokens[1:]",
    "    x = model.embed(tokens[:-1])",
    "    for block in model.blocks:",
    "        x = block(x)",
    "    return cross_entropy(model.head(model.norm(x)), targets)"
